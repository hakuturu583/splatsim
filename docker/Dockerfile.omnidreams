# =============================================================================
# OmniDreams rendering backend image.
#
# A SEPARATE image from the 3D Gaussian Splatting one (docker/Dockerfile). It
# serves the exact same gRPC `splatsim.v1.RenderingService` on port 50051, so a
# client cannot tell the two apart, but frames are synthesised by NVIDIA's
# OmniDreams / Cosmos-Dreams autoregressive world model via the FlashDreams
# runtime instead of by rasterising Gaussians.
#
# This image deliberately does NOT build gsplat / SplatAD CUDA kernels: the
# OmniDreams transport path (`splatsim.omnidreams_service`) imports only the
# pure-Python gRPC glue + the DDS publishers + FlashDreams, so those kernels are
# dead weight here.
#
# The FlashDreams runtime needs gated Hugging Face weights. Pass a token at
# BUILD time (weights are staged on first run, not baked in) or, preferably, at
# RUN time:
#   docker run --rm -it --gpus all -e HF_TOKEN=hf_xxx \
#       ghcr.io/tier4/splatsim-omnidreams
# FlashDreams validated on CUDA 12.8 / driver 570.x, and OmniDreams needs
# ~48 GB VRAM for single-view generation.
# =============================================================================
ARG CUDA_VERSION=12.8.1
ARG UBUNTU_VERSION=22.04

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    python3 \
    python3-venv \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
ENV UV_LINK_MODE=copy

WORKDIR /workspace

# -----------------------------------------------------------------------------
# 1. FlashDreams OmniDreams runtime (the world model).
#    Pinned by FLASHDREAMS_REF so the # INTEGRATION SEAM calls in
#    splatsim/omnidreams_service/renderer.py stay matched to a known release.
# -----------------------------------------------------------------------------
ARG FLASHDREAMS_REF=main
RUN git clone --depth 1 --branch ${FLASHDREAMS_REF} \
        https://github.com/NVIDIA/flashdreams.git flashdreams
WORKDIR /workspace/flashdreams
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --package flashdreams-omnidreams

# The OmniDreams integration lives in its own uv project; its venv is what we
# extend with the SplatSim transport deps and run the server from.
ENV VENV=/workspace/flashdreams/.venv
ENV PATH="${VENV}/bin:${PATH}"

# -----------------------------------------------------------------------------
# 2. SplatSim transport layer (gRPC + CycloneDDS), added into the same venv.
#    Only the deps the OmniDreams path actually imports — no gsplat / torch
#    build (FlashDreams already provides torch).
# -----------------------------------------------------------------------------
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python "${VENV}/bin/python" \
        "grpcio>=1.60" "grpcio-tools>=1.60" "protobuf>=4.25" \
        "cyclonedds>=0.10" "opencv-python-headless>=4.8" \
        "pillow>=10.0" "numpy>=1.24"

# -----------------------------------------------------------------------------
# 3. SplatSim source + generated proto. We run the server as a module with
#    PYTHONPATH=src (no `pip install .`, which would pull gsplat via
#    pyproject.toml's core deps).
# -----------------------------------------------------------------------------
WORKDIR /workspace/splatsim
COPY proto/ proto/
COPY src/ src/
RUN python src/splatsim/grpc_service/generate_proto.py

ENV PYTHONPATH=/workspace/splatsim/src
ENV SPLATSIM_LOG_LEVEL=INFO

EXPOSE 50051
CMD ["python", "-m", "splatsim.omnidreams_service.cli"]
