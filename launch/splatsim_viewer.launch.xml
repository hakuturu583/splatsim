<launch>
  <arg name="scene_yaml" />
  <arg name="dds" default="true"/>
  <arg name="image_topic" default="/splatsim/image_raw"/>
  <arg name="camera_info_topic" default="/splatsim/camera_info"/>
  <arg name="frame_id" default="splatsim_camera"/>
  <arg name="compress_format" default=""/>
  <arg name="use_lidar" default="false"
       description="Render a LiDAR panorama instead of the RGB camera view."/>
  <arg name="lidar_name" default=""
       description="Name of the LiDAR sensor (from scene YAML lidar_sensors) to render when use_lidar is true."/>

  <group if="$(var use_lidar)">
    <node pkg="splatsim" exec="splatsim-viewer" name="splatsim_viewer" output="screen"
          args="$(var scene_yaml) --lidar $(var lidar_name) --dds"
          if="$(var dds)"/>

    <node pkg="splatsim" exec="splatsim-viewer" name="splatsim_viewer" output="screen"
          args="$(var scene_yaml) --lidar $(var lidar_name)"
          unless="$(var dds)"/>
  </group>

  <group unless="$(var use_lidar)">
    <node pkg="splatsim" exec="splatsim-viewer" name="splatsim_viewer" output="screen"
          args="$(var scene_yaml) --dds --topic-image $(var image_topic) --topic-camera-info $(var camera_info_topic) --frame-id $(var frame_id) --compress-format $(var compress_format)"
          if="$(var dds)"/>

    <node pkg="splatsim" exec="splatsim-viewer" name="splatsim_viewer" output="screen"
          args="$(var scene_yaml)"
          unless="$(var dds)"/>
  </group>
</launch>
